{  "identifier":"orderBookId",
    "rules":{
    "matchId": [
        {
            "type": "Numerical check",
            "Rule Number": "1",
            "columns": [
                "matchId"
            ],
            "format_type":"Object",
            "sub_columns": [
                "matchGroupId",
                "notUsed",
                "combinationMatchId"
            ],
            "description": "The matchGroupId must be a monotonically increasing number per partition, assigned to an execution event.",
            "constraints": {
                "min": 0
            }
        }
    ],
    "orderPrice": [
        {
            "type": "Numerical check",
            "Rule Number": "1",
            "columns": [
                "orderPrice"
            ],
            "description": "The order price must be a valid numerical value.",
            "constraints": {
                "min": 1,
                "max":2
            },
            "format": "Long"
        }
    ],
    "nationalBidPriceSnapshot": [
        {
            "type": "Numerical check",
            "Rule Number": "1",
            "columns": [
                "nationalBidPriceSnapshot"
            ],
            "description": "The national bid price snapshot must be a valid long integer representing the price.",
            "constraints": {
                "min": 0
            },
            "format": "Long"
        }
    ],
    "tradeType": [
        {
            "type": "Value check",
            "Rule Number": "1",
            "columns": [
                "tradeType"
            ],
            "constraints": {
                "min": 0
            },
            "description": "The tradeType field must be a byte value representing the status of the trade.",
            "valid_values": [
                "Standard",
                "Reversing",
                "Overtaking"
            ]
        },
        {
            "type": "Range check",
            "Rule Number": "2",
            "columns": [
                "tradeType"
            ],
            "description": "The tradeType field must be within the valid byte range.",
            "constraints": {
                "min": 0
            }
        }
    ],
    "tradeCondition": [
        {
            "type": "Range check",
            "Rule Number": "TC-001",
            "columns": [
                "tradeCondition"
            ],
            "description": "The tradeCondition field must be within the valid range of integer values.",
            "constraints": {
                "min": 0,
                "max": 1
            }
        }
    ]
}
}
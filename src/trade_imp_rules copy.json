{  "identifier":"orderBookId",
    "rules":{
    "matchId": [
        {
            "type": "Numerical check",
            "Rule Number": "1",
            "columns": [
                "matchId"
            ],
            "format_type":"Object",
            "sub_columns": [
                "matchGroupId",
                "notUsed",
                "combinationMatchId"
            ],
            "description": "The matchGroupId must be a monotonically increasing number per partition, assigned to an execution event.",
            "constraints": {
                "min": 0
            }
        }
    ],
    "orderPrice": [
        {
            "type": "Numerical check",
            "Rule Number": "1",
            "columns": [
                "orderPrice"
            ],
            "description": "The order price must be a valid numerical value.",
            "constraints": {
                "min": 1,
                "max":2
            },
            "format": "Long"
        }
    ]
}
}